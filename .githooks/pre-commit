#!/bin/bash
# pre-commit: format, clippy, and test checks
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
LOCAL_RUNNER="$REPO_ROOT/scripts/with-project-temp.ps1"

if command -v pwsh >/dev/null 2>&1; then
    PS_CMD="pwsh"
else
    PS_CMD="powershell.exe"
fi

run_local() {
    "$PS_CMD" -NoProfile -File "$LOCAL_RUNNER" -Scope pre-commit "$@"
}

echo "=== cargo fmt --all -- --check ==="
run_local cargo fmt --all :: --check

echo "=== scripts/hygiene.ps1 ==="
"$PS_CMD" -NoProfile -File "$REPO_ROOT/scripts/hygiene.ps1"

echo "=== python scripts/check_code_size.py ==="
python "$REPO_ROOT/scripts/check_code_size.py"

echo "=== cargo clippy --all-targets --all-features -- -D warnings ==="
run_local cargo clippy --all-targets --all-features --locked :: -Dwarnings

echo "=== cargo test --all-targets --features _test_helpers ==="
run_local cargo test --all-targets --locked --features _test_helpers

echo "=== pre-commit OK ==="
